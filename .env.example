# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Optional overrides of the default model IDs (python -m auditor.llm lists them)
# NEMOTRON_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
# NEMOTRON_SUPER=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Hard stop for cumulative spend, in USD
SPEND_CAP_USD=35
# VAT added to the token prices on the bill (0.21 in Spain). Set it and the cap counts what is charged.
VAT_RATE=0
